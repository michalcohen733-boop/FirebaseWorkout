<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FirebaseWorkout.ViewModels"
    x:DataType="views:SignUpViewModel"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FCE7F3" />
            <GradientStop Offset="0.5" Color="#F9A8D4" />
            <GradientStop Offset="1.0" Color="#EC4899" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <Grid>
        <Grid ColumnDefinitions="*,8*,*" RowDefinitions="0.6*,4*,*">

            <!--  כותרת  -->
            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    FontSize="24"
                    Text="Create Account"
                    TextColor="#831843" />
            </HorizontalStackLayout>

            <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout>

                <!--  שדה שם פרטי  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="16"
                        Placeholder="First Name"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding FName}"
                        TextColor="#831843" />
                </Border>

                <!--  שדה שם משפחה  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="16"
                        Placeholder="Last Name"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding LName}"
                        TextColor="#831843" />
                </Border>

                <!--  שדה דואל  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="16"
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding UEmail}"
                        TextColor="#831843" />
                </Border>

                <!--  שדה סיסמה  -->
                <Border
                    Margin="0,0,0,10"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Grid
                        Padding="10"
                        ColumnDefinitions="*,Auto"
                        VerticalOptions="Center">
                        <Entry
                            BackgroundColor="Transparent"
                            FontSize="16"
                            IsPassword="{Binding EntryAsPassword}"
                            Placeholder="Password"
                            PlaceholderColor="#F9A8D4"
                            Text="{Binding UPassword}"
                            TextColor="#831843"
                            VerticalOptions="Center" />
                        <Button
                            Margin="5,0,0,0"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding TogglePasswordCommand}"
                            FontFamily="MaterialIcons"
                            FontSize="24"
                            HorizontalOptions="End"
                            Text="{Binding PasswordIconCode}"
                            TextColor="#BE185D"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  שדה מספר נייד  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="16"
                        Keyboard="Telephone"
                        Placeholder="Mobile"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding UMobile}"
                        TextColor="#831843" />
                </Border>

                <!--  כפתור הרשמה  -->
                <Button
                    Command="{Binding SignUpCommand}"
                    BackgroundColor="#BE185D"
                    CornerRadius="8"
                    FontSize="20"
                    HeightRequest="50"
                    Text="Sign Up"
                    TextColor="White" />

                <!--  Already have an account?  -->
                <HorizontalStackLayout
                    Margin="0,10,0,0"
                    HorizontalOptions="Center"
                    Spacing="6">
                    <Label
                        FontSize="14"
                        Text="Already have an account?"
                        TextColor="#831843"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="16"
                        FontAttributes="Bold"
                        Text="SignIn"
                        TextColor="#BE185D"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding NavigateToSignInCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!--  Error Message  -->
                <Label
                    Margin="0,10,0,0"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding SignUpMessageVisible}"
                    Text="{Binding ErrorMessage}"
                    TextColor="#BE185D" />

            </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!--  מסך טעינה  -->
        <Grid
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill">
            <BoxView
                BackgroundColor="#FCE7F3"
                HorizontalOptions="Fill"
                Opacity="0.7"
                VerticalOptions="Fill" />
            <ActivityIndicator
                IsRunning="True"
                WidthRequest="100"
                Color="#EC4899" />
        </Grid>
    </Grid>

</ContentPage>
