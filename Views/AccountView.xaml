<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.AccountView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FirebaseWorkout.Model"
    xmlns:views="clr-namespace:FirebaseWorkout.ViewModels"
    Title="AccountView"
    x:DataType="views:AccountViewModel">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FCE7F3" />
            <GradientStop Offset="0.5" Color="#F9A8D4" />
            <GradientStop Offset="1.0" Color="#EC4899" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Grid ColumnDefinitions="0.1*,8*,0.1*" RowDefinitions=".8*,2.6*,5.5*,*">
            <!--  Delete ImageButton  -->
            <HorizontalStackLayout
                IsVisible="{Binding IsDeleteButtonVisible}"
                Grid.ColumnSpan="3"
                Margin="0,10,20,0"
                HorizontalOptions="End"
                VerticalOptions="Center">
                <Button
                    Background="Transparent"
                    HeightRequest="60"
                    Command="{Binding DeleteCommand}"
                    FontFamily="MaterialIcons"
                    FontSize="40"
                    Text="{Binding DeleteIcon}"
                    TextColor="#831843" />

            </HorizontalStackLayout>

            <!--  User Image  -->
            <StackLayout
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0"
                VerticalOptions="Start">

                <Border
                    Background="Transparent"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Stroke="#F9A8D4"
                    StrokeThickness="1"
                    VerticalOptions="Center"
                    WidthRequest="120">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="60" />
                    </Border.StrokeShape>

                    <ImageButton
                        Aspect="Fill"
                        Command="{Binding GetUserImageCommand}"
                        HeightRequest="120"
                        Source="{Binding UserImageSource, TargetNullValue='shifu.png'}" />
                </Border>
            </StackLayout>

            <!--  User Fields  -->
            <VerticalStackLayout
                Grid.Row="2"
                Grid.Column="1"
                Margin="20,0,20,0">

                <!--  שדה שם פרטי  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="15"
                        Placeholder="First Name"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding FirstName}"
                        TextColor="#831843" />
                </Border>
                <!--  שדה שם משפחה  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="15"
                        Placeholder="Last Name"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding LastName}"
                        TextColor="#831843" />
                </Border>
                <!--  שדה דואל  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="15"
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="#F9A8D4"
                        IsEnabled="False"
                        Text="{Binding UserEmail}"
                        TextColor="Gray" />
                </Border>
                <!--  שדה מספר נייד  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    BackgroundColor="White"
                    Stroke="#F9A8D4"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Entry
                        FontSize="15"
                        Keyboard="Telephone"
                        Placeholder="Mobile"
                        PlaceholderColor="#F9A8D4"
                        Text="{Binding UserMobile}"
                        TextColor="#831843" />
                </Border>


                <VerticalStackLayout Grid.Row="4" />

                <!--  Error Message  -->
                <Label
                    Margin="30,0,0,10"
                    IsVisible="{Binding ErrorMessageIsVisible}"
                    Text="{Binding ErrorMessage}"
                    TextColor="#BE185D" />

                <!--  כפתור עדכון  -->
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding UpdateCommand}"
                    BackgroundColor="#BE185D"
                    CornerRadius="8"
                    FontSize="18"
                    HeightRequest="50"
                    Text="Update"
                    TextColor="White" />

            </VerticalStackLayout>
        </Grid>

        <!--  מסך טעינה  -->
        <Grid
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill">

            <BoxView
                BackgroundColor="#FCE7F3"
                HorizontalOptions="Fill"
                Opacity="0.7"
                VerticalOptions="Fill" />

            <ActivityIndicator
                IsRunning="True"
                WidthRequest="100"
                Color="#EC4899" />
        </Grid>
    </Grid>

</ContentPage>
