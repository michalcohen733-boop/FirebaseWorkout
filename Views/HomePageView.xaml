<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.HomePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="#FFF1F2"
    NavigationPage.HasNavigationBar="False"
    Padding="40">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="16">

        <!-- Logo -->
        <Image
            Source="issue_scanner_logo.png"
            HeightRequest="180"
            Aspect="AspectFit"
            HorizontalOptions="Center"
            Margin="0,20,0,20" />

        <!-- Subtitle -->
        <Label
            Text="Report computer issues at your school"
            FontSize="14"
            TextColor="#831843"
            HorizontalOptions="Center"
            Margin="0,0,0,24" />

        <!-- Sign In Button -->
        <Button
            Text="Sign In"
            Command="{Binding SignInCommand}"
            BackgroundColor="#EC4899"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            HeightRequest="50"
            WidthRequest="280"
            CornerRadius="12" />

        <!-- Sign Up Button -->
        <Button
            Text="Sign Up"
            Command="{Binding SignUpCommand}"
            BackgroundColor="#F9A8D4"
            TextColor="#831843"
            FontSize="16"
            FontAttributes="Bold"
            HeightRequest="50"
            WidthRequest="280"
            CornerRadius="12" />

        <!-- Enter As Guest Button -->
        <Border
            HeightRequest="50"
            WidthRequest="280"
            BackgroundColor="Transparent"
            Stroke="#EC4899"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 12">
            <Button
                Text="Enter As Guest"
                Command="{Binding EnterAsGuestCommand}"
                BackgroundColor="Transparent"
                TextColor="#BE185D"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="12" />
        </Border>

    </VerticalStackLayout>
</ContentPage>
