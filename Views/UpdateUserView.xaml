<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.UpdateUserView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Update User"
    BackgroundColor="#FFF1F2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- User info card (read-only) -->
            <Border
                BackgroundColor="#FCE7F3"
                Stroke="#F9A8D4"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="User Info"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#BE185D" />
                    <Label
                        Text="{Binding User.UserEmail}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#831843" />
                </VerticalStackLayout>
            </Border>

            <!-- Section title -->
            <Label
                Text="Edit Details"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#831843"
                Margin="0,8,0,0" />

            <!-- First Name -->
            <Label Text="First Name" FontSize="12" TextColor="#BE185D" />
            <Entry
                Text="{Binding User.FirstName}"
                BackgroundColor="White"
                TextColor="#831843"
                HeightRequest="50" />

            <!-- Last Name -->
            <Label Text="Last Name" FontSize="12" TextColor="#BE185D" Margin="0,8,0,0" />
            <Entry
                Text="{Binding User.LastName}"
                BackgroundColor="White"
                TextColor="#831843"
                HeightRequest="50" />

            <!-- Phone -->
            <Label Text="Phone" FontSize="12" TextColor="#BE185D" Margin="0,8,0,0" />
            <Entry
                Text="{Binding User.UserMobile}"
                BackgroundColor="White"
                TextColor="#831843"
                HeightRequest="50"
                Keyboard="Numeric" />

            <!-- Update button -->
            <Button
                Text="Update"
                Command="{Binding UpdateCommand}"
                BackgroundColor="#EC4899"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="12"
                FontSize="16"
                FontAttributes="Bold"
                Margin="0,24,0,0" />

            <!-- Status message -->
            <Label
                Text="{Binding StatusMessage}"
                TextColor="{Binding StatusColor}"
                HorizontalOptions="Center"
                IsVisible="{Binding HasStatusMessage}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
