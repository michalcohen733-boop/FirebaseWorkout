<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    Title="Scan QR Code"
    BackgroundColor="#FFF1F2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <HorizontalStackLayout Grid.Row="0" Padding="20">
            <Label
                Text="Issue Scanner"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#831843"
                VerticalOptions="Center"
                HorizontalOptions="StartAndExpand" />
            <Button
                Text="&#xe8b8;"
                Command="{Binding SettingsCommand}"
                BackgroundColor="Transparent"
                TextColor="#EC4899"
                FontFamily="MaterialIcons"
                FontSize="24"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Row 1: אזור סריקה - אייקון מצלמה או מצלמה פעילה -->
        <Grid Grid.Row="1" Margin="20">

            <!-- Placeholder - אייקון מצלמה שלחיצה עליו פותחת את המצלמה -->
            <Border
                IsVisible="{Binding IsPlaceholderVisible}"
                BackgroundColor="White"
                Stroke="#EC4899"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="4"
                HeightRequest="400">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <Label
                        Text="&#xe412;"
                        FontFamily="MaterialIcons"
                        FontSize="80"
                        TextColor="#EC4899"
                        HorizontalOptions="Center" />
                    <Label
                        Text="לחצי לסריקה"
                        FontSize="18"
                        TextColor="#BE185D"
                        HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCameraCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Border>

            <!-- מצלמה - מוצגת רק אחרי לחיצה על האייקון -->
            <Border
                IsVisible="{Binding IsCameraVisible}"
                BackgroundColor="White"
                Stroke="#EC4899"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="4"
                HeightRequest="400">
                <scanner:CameraView
                    x:Name="cameraView"
                    CameraEnabled="{Binding IsCameraVisible}"
                    CameraFacing="Back"
                    BarcodeSymbologies="QRCode"
                    OnDetectionFinished="OnBarcodesDetected" />
            </Border>

        </Grid>

        <!-- Row 2: Manual entry -->
        <VerticalStackLayout Grid.Row="2" Margin="20" Spacing="12">
            <Label
                Text="Or enter code manually:"
                FontSize="14"
                TextColor="#831843" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Entry
                    Grid.Column="0"
                    Placeholder="Enter computer code"
                    Text="{Binding ManualCode}"
                    BackgroundColor="White"
                    TextColor="#831843"
                    HeightRequest="50"
                    Margin="0,0,8,0" />
                <Button
                    Grid.Column="1"
                    Text="Go"
                    Command="{Binding SubmitManualCodeCommand}"
                    BackgroundColor="#EC4899"
                    TextColor="White"
                    WidthRequest="80"
                    HeightRequest="50"
                    CornerRadius="12"
                    FontAttributes="Bold" />
            </Grid>
        </VerticalStackLayout>

        <!-- Row 3: Status message -->
        <Label
            Grid.Row="3"
            Text="{Binding StatusMessage}"
            TextColor="#BE185D"
            HorizontalOptions="Center"
            Margin="0,0,0,20"
            IsVisible="{Binding HasStatusMessage}" />

    </Grid>
</ContentPage>
