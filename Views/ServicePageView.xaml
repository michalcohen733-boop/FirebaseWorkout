<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirebaseWorkout.Views.ServicePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:FirebaseWorkout.Model"
    Title="Service"
    BackgroundColor="#FFF1F2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <HorizontalStackLayout Grid.Row="0" Padding="20">
            <Label
                Text="Open Issues"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#831843"
                HorizontalOptions="StartAndExpand"
                VerticalOptions="Center" />
            <Label
                Text="{Binding ReportsCount}"
                FontSize="14"
                TextColor="#BE185D"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Row 1: Reports list -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Reports}"
            SelectionMode="Single"
            SelectionChanged="OnReportSelected">

            <!-- Empty state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">
                    <Label
                        Text="🎉"
                        FontSize="48"
                        HorizontalOptions="Center" />
                    <Label
                        Text="No open issues"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#831843"
                        HorizontalOptions="Center" />
                    <Label
                        Text="All computers are working well!"
                        FontSize="14"
                        TextColor="#BE185D"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Report">
                    <Border
                        Margin="20,4"
                        Padding="16"
                        BackgroundColor="#FCE7F3"
                        Stroke="#F9A8D4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">

                            <!-- Computer number + Status badge -->
                            <HorizontalStackLayout>
                                <Label
                                    Text="{Binding ComputerNumber}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#831843"
                                    HorizontalOptions="StartAndExpand"
                                    VerticalOptions="Center" />
                                <Border
                                    BackgroundColor="#FECDD3"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4">
                                    <Label
                                        Text="{Binding Status}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#BE185D" />
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Room -->
                            <Label
                                Text="{Binding Room}"
                                FontSize="14"
                                TextColor="#BE185D" />

                            <!-- Issues summary -->
                            <Label
                                Text="{Binding IssuesSummary}"
                                FontSize="14"
                                TextColor="#831843"
                                LineBreakMode="WordWrap" />

                            <!-- Divider -->
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#F9A8D4"
                                Margin="0,4" />

                            <!-- Reporter + Date -->
                            <HorizontalStackLayout>
                                <Label
                                    Text="Reported by:"
                                    FontSize="12"
                                    TextColor="#BE185D" />
                                <Label
                                    Text="{Binding ReporterName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#831843"
                                    Margin="4,0,0,0" />
                                <Label
                                    Text="{Binding ReportDate}"
                                    FontSize="12"
                                    TextColor="#BE185D"
                                    HorizontalOptions="EndAndExpand" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
